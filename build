name: Build BuildBuddy mod

on:
  workflow_dispatch:
  push:
    paths:
      - 'BuildBuddy-GitHub-starter.zip'

permissions:
  contents: read

env:
  ZIP_FILE: BuildBuddy-GitHub-starter.zip

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Check out repository
        uses: actions/checkout@v4

      - name: Check starter archive
        run: test -f "$ZIP_FILE" || { echo "Missing $ZIP_FILE in repository root"; exit 1; }

      - name: Set up Java 25
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '25'

      - name: Set up Gradle 9.5.1
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '9.5.1'

      - name: Extract project archive
        run: |
          mkdir -p _buildbuddy
          unzip -q -o "$ZIP_FILE" -d _buildbuddy
          test -f _buildbuddy/BuildBuddy/build.gradle
          test -f _buildbuddy/BuildBuddy/src/main/resources/fabric.mod.json

      - name: Build Fabric mod
        working-directory: _buildbuddy/BuildBuddy
        run: gradle --no-daemon clean build

      - name: Upload JAR artifact
        uses: actions/upload-artifact@v4
        with:
          name: BuildBuddy-JAR
          path: _buildbuddy/BuildBuddy/build/libs/*.jar
          if-no-files-found: error
